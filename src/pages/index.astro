---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import Icon from '../components/Icon.astro';
import { site, principal, services, careerBrands, heroProof, problems, engagement, results } from '../data/site';
import { p } from '../lib/paths';

const title = 'Food & Protein Industry Consulting | KP Consulting';
const description =
  'Consulting for protein producers, food brands and grocery retailers: get on the shelf at national retail, prove your supply chain, and fix an underperforming meat category. 37 years of operating experience behind every engagement.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': `${site.url}/#organization`,
    name: site.name,
    legalName: site.legalName,
    url: site.url,
    email: site.email,
    description,
    image: `${site.url}/og.png`,
    priceRange: '$$$',
    areaServed: [{ '@type': 'Country', name: 'United States' }, { '@type': 'Country', name: 'Canada' }],
    address: { '@type': 'PostalAddress', addressLocality: 'Windsor', addressRegion: 'CO', addressCountry: 'US' },
    founder: { '@id': `${site.url}/#kent` },
    knowsAbout: [
      'Food supply chain traceability',
      'DNA origin and species verification',
      'Meat and seafood category management',
      'Retail go-to-market strategy',
      'Hispanic and multicultural food marketing',
    ],
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Consulting services',
      itemListElement: services.map((s) => ({
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: s.name,
          description: s.summary,
          url: `${site.url}/services/${s.slug}/`,
        },
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${site.url}/#kent`,
    name: principal.name,
    jobTitle: principal.role,
    worksFor: { '@id': `${site.url}/#organization` },
    alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Southern California' },
    sameAs: [site.linkedin].filter(Boolean),
    url: `${site.url}/about/`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    url: site.url,
    name: site.name,
    publisher: { '@id': `${site.url}/#organization` },
  },
];

const audiences = [
  {
    who: 'Protein producers & processors',
    body: 'You have the product and the plant. What you are missing is the merchandiser relationship and proof of origin that survives a line review.',
  },
  {
    who: 'Food brands scaling into national retail',
    body: 'You win regional accounts and get ignored by national ones. Usually the deck is the problem — it is built around your brand instead of the buyer’s category gap.',
  },
  {
    who: 'Grocery retailers & category teams',
    body: 'The meat department is under-earning its square footage. Assortment, service case, private label, and an un-merchandised shopper are the usual four reasons.',
  },
  {
    who: 'Packers & further processors',
    body: 'Private label programs, primal rollouts and value-added lines — built and sold from the supplier side into Kroger divisions across the country.',
  },
  {
    who: 'Investors & boards in food',
    body: 'An operator’s read on whether a protein business can actually hold the shelf space its projections assume.',
  },
];
---
<Base title={title} description={description} path="/" schema={schema}>
  <!-- ===================== HERO ===================== -->
  <section class="hero band--dark">
    <div class="hero__bg" aria-hidden="true">
      <img alt="" width="2560" height="900" fetchpriority="high"
            srcset={`${p("/img/case-clean-1280.webp")} 1280w, ${p("/img/case-clean-1920.webp")} 1920w, ${p("/img/case-clean-2560.webp")} 2560w`}
            sizes="100vw"
          />
    </div>

    <div class="wrap hero__inner">
      <div class="hero__copy">
        <p class="tag">Food &amp; protein industry consulting</p>
        <h1 class="hero__head">
          Sell more protein.<br />Prove its origin.<span class="hero__gold">Win the category.</span>
        </h1>
        <p class="hero__lede">
          KP Consulting helps protein producers, food brands and grocery retailers
          <strong>open retail doors</strong>, <strong>defend their origin claims</strong>, and
          <strong>turn an underperforming meat department into a profitable one</strong> — with an
          operator who has run the category, sold into it, and verified it.
        </p>
        <div class="hero__actions">
          <a class="btn" href={p("/contact/")}>Schedule a free consultation</a>
          <a class="btn btn--ghost" href={p("/services/")}>Explore the services</a>
        </div>
      </div>

      <figure class="hero__portrait">
        <img width="560" height="700" alt={`${principal.name}, principal of ${site.name}`}
            srcset={`${p("/img/kent-portrait-560.webp")} 1x, ${p("/img/kent-portrait-840.webp")} 1.5x`}
          />
        <figcaption>
          <span class="hero__pname">{principal.name}</span>
          <span class="hero__prole">{principal.role}</span>
        </figcaption>
      </figure>
    </div>

    <div class="wrap">
      <ul class="hero__proof">
        {heroProof.map((item) => (
          <li>
            <span class="hero__proof-icon"><Icon name={item.icon} size={26} /></span>
            <span class="hero__proof-text">
              <strong>{item.value}</strong>
              <span>{item.label}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===================== CAREER STRIP ===================== -->
  <section class="strip">
    <div class="wrap">
      <p class="strip__label">Experience built inside</p>
      <ul class="strip__list">
        {careerBrands.map((b) => <li>{b}</li>)}
      </ul>
      <p class="strip__note">
        Former employers and retail accounts from Kent’s career. Not clients of {site.name}, and not endorsements.
      </p>
    </div>
  </section>

  <!-- ===================== PROBLEMS ===================== -->
  <section class="band">
    <div class="wrap">
      <div class="head head--center">
        <p class="tag">What he fixes</p>
        <h2>Three problems, and what changes when they are solved</h2>
        <p class="lede head__lede">
          Most calls start with one of these. The engagement is judged on whether the second column
          actually happens.
        </p>
      </div>

      <ol class="probs">
        {problems.map((item, i) => (
          <li class="prob reveal" style={`--delay:${i * 80}ms`}>
            <span class="prob__icon"><Icon name={item.icon as any} size={24} /></span>
            <div class="prob__q">
              <h3>{item.problem}</h3>
            </div>
            <p class="prob__a">{item.outcome}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ===================== POSITIONING BAND ===================== -->
  <section class="stripe">
    <div class="stripe__bg" aria-hidden="true">
      <img
        src={p("/img/pasture-900.webp")}
        srcset={`${p("/img/pasture-900.webp")} 900w, ${p("/img/pasture-1600.webp")} 1600w`}
        sizes="100vw"
        width="900" height="506"
        alt=""
        loading="lazy"
      />
    </div>
    <div class="wrap stripe__inner">
      <p class="stripe__quote">
        “Whichever side of the table you are on, he has already sat on the other one.”
      </p>
      <p class="stripe__by">
        Retailer at Kroger · Supplier at Meyer Natural Foods · Technology at Merck Animal Health
      </p>
    </div>
  </section>

  <!-- ===================== HOW IT WORKS ===================== -->
  <section class="band band--dark">
    <div class="wrap">
      <div class="head head--center">
        <p class="tag">How it works</p>
        <h2>No discovery phase you pay for twice</h2>
        <p class="lede head__lede">
          Kent has already run your category, sold into it, or audited it. Engagements start from
          that, not from a month of getting up to speed.
        </p>
      </div>

      <ol class="steps">
        {engagement.map((item, i) => (
          <li class="step reveal" style={`--delay:${i * 80}ms`}>
            <span class="step__n">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="step__name">{item.step}</h3>
            <p class="step__body">{item.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ===================== SERVICES ===================== -->
  <section class="band band--off" id="services">
    <div class="wrap">
      <div class="head head--center">
        <p class="tag">Where to start</p>
        <h2>Four ways to put 37 years to work on your business</h2>
        <p class="lede head__lede">
          Pick the one that matches what is broken. Most engagements begin as one of these and turn
          into another once the real constraint shows up.
        </p>
      </div>

      <div class="grid grid--2 svc-grid">
        {services.map((s, i) => (
          <article class="card card--link svc reveal" style={`--delay:${i * 80}ms`}>
            <span class="svc__order">{s.order}</span>
            <h3 class="svc__title"><a href={p(`/services/${s.slug}/`)}>{s.name}</a></h3>
            <p class="svc__tagline">{s.tagline}</p>
            <ul class="ticks svc__ticks">
              {s.outcomes.slice(0, 2).map((o) => <li>{o}</li>)}
            </ul>
            <span class="svc__more">Read more <span class="btn__arrow" aria-hidden="true">→</span></span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== AUDIENCE ===================== -->
  <section class="band band--dark">
    <div class="wrap split split--reverse">
      <div class="split__copy">
        <p class="tag">Who this is for</p>
        <h2>Built for companies that sell protein</h2>
        <ul class="who">
          {audiences.map((a) => (
            <li><strong>{a.who}</strong> — {a.body}</li>
          ))}
        </ul>
        <a class="btn who__btn" href={p("/contact/")}>Schedule a free consultation</a>
      </div>
      <div class="split__media split__media--stats">
        <div class="statbox">
          <p class="statbox__head">What this work has produced</p>
          {results.map((item) => (
            <div class="statbox__row">
              <p class="figure__value">{item.value}</p>
              <div>
                <p class="figure__label">{item.label}</p>
                <p class="figure__note">{item.note}</p>
              </div>
            </div>
          ))}
          <a class="statbox__link" href={p("/track-record/")}>
            See the full track record <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <Cta />
</Base>

<style>
  /* ---------- hero ---------- */
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(3rem, 7vw, 5.5rem) 0;
    overflow: hidden;
  }
  .hero__bg { position: absolute; inset: 0; z-index: -2; }
  .hero__bg img { width: 100%; height: 100%; object-fit: cover; }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    /* Heavy enough on the left to keep the headline legible, light enough on
       the right that the case still reads as clean and well lit. */
    background:
      linear-gradient(to right,
        color-mix(in srgb, var(--night) 85%, transparent) 0%,
        color-mix(in srgb, var(--night) 66%, transparent) 40%,
        color-mix(in srgb, var(--night) 28%, transparent) 100%),
      linear-gradient(to bottom,
        color-mix(in srgb, var(--night) 45%, transparent) 0%,
        transparent 20%,
        color-mix(in srgb, var(--night) 62%, transparent) 100%);
  }
  .hero__inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }
  /* Below 72rem the copy column gets too narrow for the headline to hold its
     three lines, so the hero stacks rather than breaking mid-sentence. */
  @media (min-width: 72rem) {
    .hero__inner { grid-template-columns: minmax(0, 1fr) 24rem; }
  }
  .hero__head { margin-top: 1.2rem; max-width: 24ch; font-size: var(--step-5); }
  /* The payoff line sits on its own row. */
  .hero__gold { color: var(--gold); display: block; }
  .hero__lede {
    margin-top: 1.5rem;
    max-width: 58ch;
    font-size: var(--step-1);
    line-height: 1.62;
    /* Near-white: the muted grey lost contrast once the scrim lifted. */
    color: color-mix(in srgb, var(--frost) 90%, transparent);
  }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 2.1rem; }

  .hero__portrait { margin: 0; }
  .hero__portrait img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--rule-dark);
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.5);
  }
  .hero__portrait figcaption {
    display: grid;
    gap: 0.2rem;
    margin-top: 1rem;
    padding-left: 0.9rem;
    border-left: 3px solid var(--gold);
  }
  .hero__pname { font-family: var(--display); font-weight: 800; color: var(--white); font-size: 1rem; }
  .hero__prole { font-size: 0.8rem; color: var(--frost-faint); }
  @media (max-width: 71.99rem) { .hero__portrait { max-width: 18rem; } }

  .hero__proof {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 1.75rem 0 clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--rule-dark);
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }
  .hero__proof li { display: flex; align-items: center; gap: 0.95rem; }
  .hero__proof-icon {
    display: grid;
    place-items: center;
    width: 2.9rem; height: 2.9rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--gold) 14%, transparent);
    color: var(--gold);
    flex: none;
  }
  .hero__proof-text { display: grid; gap: 0.1rem; }
  .hero__proof-text strong { font-family: var(--display); font-weight: 800; color: var(--white); font-size: 1.05rem; }
  .hero__proof-text span { font-size: 0.83rem; color: var(--frost-faint); line-height: 1.4; }

  /* ---------- career strip ---------- */
  .strip { background: var(--white); padding-block: clamp(2.2rem, 4vw, 3.2rem); border-bottom: 1px solid var(--rule); }
  .strip__label {
    text-align: center;
    font-family: var(--display);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .strip__list {
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem clamp(1.4rem, 3.5vw, 3rem);
  }
  .strip__list li {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(0.95rem, 0.85rem + 0.5vw, 1.25rem);
    letter-spacing: -0.02em;
    color: var(--ink);
    opacity: 0.55;
  }
  .strip__note { margin-top: 1.3rem; text-align: center; font-size: 0.76rem; color: var(--ink-faint); }

  /* ---------- split ---------- */
  .split { display: grid; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  @media (min-width: 60rem) {
    .split { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .split--reverse .split__copy { order: 2; }
    .split--reverse .split__media { order: 1; }
  }
  .split__media { margin: 0; }
  .split__media img { width: 100%; height: auto; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); }

  /* ---------- problems ---------- */
  .probs { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .prob {
    display: grid;
    gap: 0.9rem 2rem;
    padding: clamp(1.6rem, 3vw, 2.2rem) 0;
    border-top: 1px solid var(--rule);
    align-items: start;
  }
  .prob:last-child { border-bottom: 1px solid var(--rule); }
  @media (min-width: 56rem) {
    .prob { grid-template-columns: auto minmax(0, 1fr) minmax(0, 1.25fr); }
  }
  .prob__icon {
    display: grid;
    place-items: center;
    width: 2.9rem; height: 2.9rem;
    border-radius: 50%;
    background: var(--gold-wash);
    color: var(--gold-deep);
    flex: none;
  }
  .prob__q h3 { font-size: var(--step-1); }
  .prob__a { color: var(--ink-soft); font-size: var(--step--1); line-height: 1.68; }

  /* ---------- positioning stripe ---------- */
  .stripe {
    position: relative;
    isolation: isolate;
    padding-block: clamp(3.5rem, 8vw, 6rem);
    overflow: hidden;
    text-align: center;
    color: var(--white);
  }
  .stripe__bg { position: absolute; inset: 0; z-index: -2; }
  .stripe__bg img { width: 100%; height: 100%; object-fit: cover; }
  .stripe::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to bottom, color-mix(in srgb, var(--night) 82%, transparent), color-mix(in srgb, var(--night) 68%, transparent));
  }
  .stripe__inner { max-width: 44rem; }
  .stripe__quote {
    font-family: var(--display);
    font-weight: 800;
    font-size: var(--step-2);
    line-height: 1.28;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .stripe__by {
    margin-top: 1.1rem;
    font-size: var(--step--1);
    color: var(--frost-soft);
  }

  /* ---------- how it works ---------- */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
  @media (min-width: 54rem) { .steps { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .step {
    background: color-mix(in srgb, var(--white) 4%, transparent);
    border: 1px solid var(--rule-dark);
    border-radius: var(--radius-lg);
    padding: clamp(1.3rem, 2.5vw, 1.8rem);
  }
  .step__n {
    display: grid;
    place-items: center;
    width: 2.4rem; height: 2.4rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--gold) 16%, transparent);
    color: var(--gold);
    font-family: var(--display);
    font-weight: 800;
    font-size: 0.82rem;
  }
  .step__name { margin-top: 1rem; font-size: var(--step-1); }
  .step__body { margin-top: 0.6rem; font-size: var(--step--1); line-height: 1.65; color: var(--frost-soft); }

  /* ---------- section heads ---------- */
  .head { margin-bottom: clamp(2.2rem, 4vw, 3.2rem); }
  .head--center { text-align: center; max-width: 46rem; margin-inline: auto; }
  .head h2 { margin-top: 0.9rem; }
  .head__lede { margin: 1.1rem auto 0; }

  /* ---------- services ---------- */
  .svc { display: flex; flex-direction: column; }
  .svc__order {
    font-family: var(--display);
    font-weight: 800;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    color: var(--gold-deep);
  }
  .svc__title { margin-top: 0.7rem; font-size: var(--step-2); }
  .svc__title a { text-decoration: none; }
  .svc__tagline { margin-top: 0.7rem; color: var(--ink-soft); }
  .svc__ticks { margin-top: 1.3rem; font-size: var(--step--1); }
  .svc__more {
    margin-top: auto;
    padding-top: 1.5rem;
    font-family: var(--display);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--gold-deep);
  }

  /* ---------- audience ---------- */
  .who { list-style: none; margin: 1.6rem 0 0; padding: 0; display: grid; gap: 1.05rem; }
  .who li {
    position: relative;
    padding-left: 1.5rem;
    color: var(--frost-soft);
    font-size: var(--step--1);
    line-height: 1.62;
  }
  .who li::before {
    content: '';
    position: absolute;
    left: 0; top: 0.62em;
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--gold);
  }
  .who__btn { margin-top: 2rem; }
  /* The value column is sized by its widest entry ("1.5M lbs"), and every row
     borrows that track through subgrid so the labels line up instead of each
     row measuring itself. A fixed track here overflowed into the label. */
  .statbox {
    background: color-mix(in srgb, var(--white) 5%, transparent);
    border: 1px solid var(--rule-dark);
    border-radius: var(--radius-lg);
    padding: clamp(1.3rem, 3vw, 2rem);
    display: grid;
    gap: 1.3rem;
    grid-template-columns: minmax(0, max-content) minmax(0, 1fr);
  }
  .statbox__head,
  .statbox__link { grid-column: 1 / -1; }
  .statbox__row {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    gap: 0.25rem 1.25rem;
    align-items: baseline;
    padding-bottom: 1.3rem;
    border-bottom: 1px solid var(--rule-dark);
  }
  .statbox .figure__value { white-space: nowrap; }

  /* No subgrid, or not enough room for two columns: stack the value above its
     label rather than letting anything collide. */
  @supports not (grid-template-columns: subgrid) {
    .statbox { grid-template-columns: minmax(0, 1fr); }
    .statbox__row { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 26rem) {
    .statbox { grid-template-columns: minmax(0, 1fr); }
    .statbox__row { grid-template-columns: minmax(0, 1fr); }
  }
  .statbox__head {
    font-family: var(--display);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .statbox__link {
    font-family: var(--display);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold);
    text-decoration: none;
  }
  .statbox__link:hover { text-decoration: underline; text-underline-offset: 0.3em; }
</style>
