---
import { p } from '../lib/paths';
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  crumbs?: { href: string; label: string }[];
}
const { eyebrow, title, lede, crumbs = [] } = Astro.props;
---
<section class="page-hero band--dark">
  <div class="wrap">
    {crumbs.length > 0 && (
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href={p("/")}>Home</a></li>
          {crumbs.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
        </ol>
      </nav>
    )}
    <p class="tag">{eyebrow}</p>
    <h1 class="page-hero__title">{title}</h1>
    {lede && <p class="lede page-hero__lede">{lede}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    padding-block: clamp(2rem, 4vw, 3rem) clamp(3rem, 6vw, 4.5rem);
    position: relative;
    overflow: hidden;
    background: var(--night);
  }
  .page-hero::before {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 3px;
    background: linear-gradient(to right, var(--gold), color-mix(in srgb, var(--gold) 15%, transparent) 70%);
  }
  .crumbs { margin-bottom: 1.8rem; }
  .crumbs ol {
    display: flex; flex-wrap: wrap; gap: 0.4rem 0.7rem;
    list-style: none; margin: 0; padding: 0;
    font-size: 0.78rem;
    color: var(--frost-faint);
  }
  .crumbs li + li::before { content: '/'; margin-right: 0.7rem; }
  .crumbs a { text-decoration: none; color: var(--frost-faint); }
  .crumbs a:hover { color: var(--gold); }
  .page-hero__title { margin-top: 1rem; max-width: 22ch; }
  .page-hero__lede { margin-top: 1.3rem; }
</style>
