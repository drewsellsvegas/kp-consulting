---
/** The KP monogram, drawn as a two-letter livestock brand. */
interface Props { size?: number; class?: string; }
const { size = 30, class: cls = '' } = Astro.props;
---
<svg
  class={cls}
  width={size} height={size * (56 / 100)} viewBox="0 0 100 56"
  fill="none" stroke="currentColor" stroke-width="9" stroke-linecap="butt"
  aria-hidden="true" focusable="false"
>
  <path d="M8.5 6 V50" />
  <path d="M13 28 L34 6" stroke-linecap="round" />
  <path d="M13 28 L36 50" stroke-linecap="round" />
  <path d="M60.5 6 V50" />
  <path d="M65 10.5 H74 A10.5 10.5 0 0 1 74 31.5 H65" stroke-linejoin="round" />
</svg>
