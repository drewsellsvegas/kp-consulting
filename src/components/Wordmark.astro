---
import BrandMark from './BrandMark.astro';
import { site } from '../data/site';
import { p } from '../lib/paths';
interface Props { href?: string | null; compact?: boolean; }
const { href = '/', compact = false } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag href={href ? p(href) : undefined} class="wordmark" aria-label={`${site.name} — home`}>
  <BrandMark variant="full" height={30} class="wordmark__mark" />
  <span class="wordmark__text">
    <span class="wordmark__name">{site.name}</span>
    {!compact && <span class="wordmark__sub">Food &amp; Protein Industry Advisors</span>}
  </span>
</Tag>

<style>
  .wordmark { display: inline-flex; align-items: center; gap: 0.8rem; text-decoration: none; color: inherit; }
  .wordmark :global(.wordmark__mark) { color: var(--gold); flex: none; transition: color 180ms ease; }
  .wordmark:hover :global(.wordmark__mark) { color: var(--gold-bright); }
  .wordmark__text { display: grid; gap: 0.22rem; }
  .wordmark__name {
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.06rem;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .wordmark__sub {
    font-family: var(--display);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink-faint);
    line-height: 1.1;
  }
  :global(.band--dark) .wordmark__sub { color: var(--frost-faint); }

  @media (max-width: 30rem) {
    .wordmark { gap: 0.6rem; }
    .wordmark :global(.wordmark__mark) { height: 24px; width: auto; }
    .wordmark__sub { display: none; }
  }
</style>
