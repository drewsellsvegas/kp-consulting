---
import { site } from '../data/site';
import { p } from '../lib/paths';
interface Props { eyebrow?: string; heading?: string; body?: string; }
const {
  eyebrow = 'Next step',
  heading = 'Start with a conversation, not a proposal',
  body = 'Thirty minutes to hear what you are trying to move — the case, the account, or the chain behind it. If it is not a fit, you will hear that on the call, along with who to talk to instead.',
} = Astro.props;
---
<section class="cta band--dark">
  <div class="wrap cta__inner">
    <div>
      <p class="tag">{eyebrow}</p>
      <h2 class="cta__head">{heading}</h2>
      <p class="cta__body">{body}</p>
    </div>
    <div class="cta__actions">
      <a class="btn" href={p("/contact/")}>Schedule a free consultation</a>
      <a class="btn btn--ghost" href={`mailto:${site.email}`}>Email Kent directly</a>
    </div>
  </div>
</section>

<style>
  .cta { padding-block: clamp(3.5rem, 7vw, 6rem); background: var(--night-2); position: relative; }
  .cta::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: linear-gradient(to right, var(--gold), color-mix(in srgb, var(--gold) 20%, transparent));
  }
  .cta__inner { display: grid; gap: clamp(1.8rem, 4vw, 3.5rem); align-items: center; }
  @media (min-width: 58rem) {
    .cta__inner { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); }
  }
  .cta__head { margin-top: 1rem; }
  .cta__body { margin-top: 1.1rem; color: var(--frost-soft); max-width: 54ch; }
  .cta__actions { display: flex; flex-wrap: wrap; gap: 0.85rem; }
</style>
